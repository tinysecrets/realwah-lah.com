# Telegram bridge environment variables
# TELEGRAM_BOT_TOKEN: your Telegram bot token (optional; required to download media attachments)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET: optional secret token to set when configuring the Telegram webhook (Telegram header X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USERS: comma-separated usernames or Telegram user IDs allowed to trigger edits (e.g. adminuser,12345678)
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_ENABLED: set to 'false' to disable the router
TELEGRAM_ENABLED=true

# OpenRouter (free-tier) credentials
# Set OPENROUTER_API_KEY in the production environment or CI secret store. DO NOT commit keys.
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://api.openrouter.ai/v1/chat/completions
OPENROUTER_MODEL=gpt-4o-mini

# GitHub / gh CLI
# gh CLI recommended; for automation you may set GITHUB_TOKEN (PAT with repo access)
GITHUB_REPO=owner/repo
GITHUB_TOKEN=

# Cloudflare (optional) - used for DNS, caching, or Pages integration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Render (optional) - used if deploying worker or web services on Render
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Bridge commands
BRIDGE_BUILD_CMD=yarn build --silent
BRIDGE_TEST_CMD=pytest -q

# Optional: customize processing schedule (seconds)
BRIDGE_POLL_INTERVAL=60
