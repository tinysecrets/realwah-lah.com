# WAH-LAH Backend Environment Variables
# Copy to .env and fill in — never commit real secrets.

# ---- Telegram / WhatsApp bridges -----------------------------------
# Enable only one at a time. Use 'true'/'1'/'yes' to enable.
TELEGRAM_ENABLED=false
WHATSAPP_ENABLED=false

# ---- Credit loop (pool_pull) ----------------------------------------
# Reclaim redeemed platform credits back to seats. SAFE: pull only fires when
# a hub AND proxy both declare pull_supported (none do yet → clean
# "unsupported" → wholesale fallback). Never blocks or fails a redemption.
POOL_PULL_ENABLED=true
# Credit rebalancer (sweep-to-lowest + capacity alert). Real sweeps require
# an explicit dry_run=false invocation; the resync worker only runs it dry-run.
POOL_REBALANCE_ENABLED=true
# Pool balance resync (nightly) — refreshes each seat's real balance from its
# hub and runs a SAFE dry-run rebalance after the pass.
POOL_RESYNC_ENABLED=true
POOL_RESYNC_INTERVAL_MIN=1440
POOL_RESYNC_RUN_REBALANCE=true
# ---- On-duty watchdog -----------------------------------------------
# Automated 24/7 health monitor. Emails the operator on degradation/recovery.
# Leave ALERT_EMAILS empty to run the watchdog without email alerts.
ON_DUTY_INTERVAL_MIN=15
ALERT_EMAILS=
