{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "yarn --cwd frontend install --frozen-lockfile",
  "buildCommand": "yarn --cwd frontend build && rm -rf dist && cp -r frontend/dist dist",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
