{
  "name": "wah-lah",
  "version": "1.0.0",
  "private": true,
  "description": "WAH-LAH monorepo — FastAPI backend (Render.com) + React frontend (Cloudflare Pages) + MongoDB Atlas",
  "scripts": {
    "backend:install": "pip install -r backend/requirements.txt",
    "backend:run": "cd backend && PYTHONPATH=. uvicorn server:app --reload --host 0.0.0.0 --port 8001",
    "backend:test": "cd backend && pytest -v",
    "backend:health": "curl http://localhost:8001/api/health",
    "frontend:install": "yarn --cwd frontend install --frozen-lockfile",
    "frontend:build": "yarn --cwd frontend build",
    "frontend:start": "yarn --cwd frontend start",
    "install": "npm run backend:install && npm run frontend:install",
    "start": "npm run backend:run & npm run frontend:start",
    "test": "npm run backend:test",
    "clean": "rm -rf backend/.venv frontend/node_modules .pytest_cache"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.9.2"
  }
}
