# ============================================================================
# WAH-LAH Monorepo — Unified Environment Template
# One .env for both WAH-LAH backend and Genie Sidekick
# All secrets managed on the deployment platform — reference only
# ============================================================================

# ---- DATABASE (Shared) --------------------------------------------------
MONGO_URL=
MONGODB_URI=
MONGO_URI=
DB_NAME=

# ---- WAH-LAH Backend Auth -----------------------------------------------
# min 32 chars: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
COOKIE_SECURE=
COOKIE_SAMESITE=
CORS_ORIGINS=
# true ONLY when running behind the Cloudflare API proxy (production)
TRUST_PROXY_HEADERS=
ENFORCE_CANONICAL_HOST=
CANONICAL_HOST=
FRONTEND_URL=https://wah-lah.com
PASSWORD_RESET_PATH=/reset-password
FRONTEND_DIR=/app/genie_dist
# production | development — MUST be "production" on Render
APP_ENV=
# Rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=20/minute
RATE_LIMIT_REGISTER=10/minute

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- WAH-LAH Payments ---------------------------------------------------
CARD_PAYMENT_TAG=
CRYPTO_WALLET_ADDRESS=
LIGHTNING_ADDRESS=

# ---- WAH-LAH Bitcoin/BTC Pay -------------------------------------------
BTCPAY_API_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTC_GATEWAY_TYPE=
# Generic payout gateway — only used when BTC_GATEWAY_TYPE selects it
# (default is local custody, which ignores these two).
BTC_GATEWAY_API_URL=
BTC_GATEWAY_API_KEY=

# ---- Bitcoin deposit processing (BlockCypher + Coinbase rate) ---------
# Token: https://accounts.blockcypher.com/. Address: a BTC address you control
# (all deposits go here). HD wallet vars optional if using a static address.
BLOCKCYPHER_TOKEN=
BLOCKCYPHER_STATIC_ADDRESS=
BLOCKCYPHER_XPUB=
BLOCKCYPHER_HD_WALLET=wah_lah_deposits
BTC_MIN_CONFIRMATIONS=2
# Optional explicit stale-price fallback. Leave EMPTY (recommended): with no
# fallback set, a dead price oracle halts pricing loudly instead of
# mispricing deposits/payouts at a frozen number.
BTC_FALLBACK_USD=
BTC_PRICE_URL=
BTC_PRICE_URL_SECONDARY=
# Public base URL of the API — used for outbound webhook callback URLs.
PUBLIC_API_URL=https://api.wah-lah.com

# ---- BTC Payout custody (locally-custodied HD funding wallet) ------------
# Extended private key (xprv) of the funding wallet holding payout BTC.
# Payouts are signed server-side and broadcast via BlockCypher.
# HOT-WALLET DISCIPLINE: fund ONLY m/0'/0/0 (the sender spends that address
# alone), keep the balance small, sweep the rest to cold storage.
BTC_PAYOUT_XPRV=
# Fee rate in satoshis-per-virtual-byte for payout transactions.
BTC_PAYOUT_FEE_SAT_PER_BYTE=3
# Per-transaction payout ceiling in satoshis. 0 = uncapped (not recommended).
BTC_PAYOUT_MAX_SAT=500000

# ---- WAH-LAH Email (Resend) --------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Legacy sender names are retained only for backward compatibility.
EMAIL_FROM=
CUSTOM_EMAIL_FROM=

# ---- WAH-LAH Compliance -------------------------------------------------
# Unset = safe production default (WA,ID,MT,NV,LA,TN,MI,UT,AZ). Set explicitly
# to override per attorney advice; empty string disables (not recommended).
BLOCKED_STATES=
# true (default) = geolocation failures DENY. Never false in production.
GEOBLOCK_FAIL_CLOSED=true
KYC_BASIC_THRESHOLD_USD=
KYC_ENHANCED_THRESHOLD_USD=
KYC_UPLOAD_DIR=
PERSONA_API_KEY=
PERSONA_ENVIRONMENT=
PERSONA_TEMPLATE_ID_BASIC=
PERSONA_TEMPLATE_ID_ENHANCED=
PERSONA_WEBHOOK_SECRET=
CTR_THRESHOLD_USD=
SAR_FREQ_WINDOW_HOURS=
SAR_FREQ_THRESHOLD=

# ---- WAH-LAH Distributor Pool -------------------------------------------
PROXY_ENCRYPTION_KEY=
PROXY_DEFAULT_PER_TRANSFER_CAP=
PROXY_DEFAULT_DAILY_CAP=
PROXY_COOLDOWN_FAILURES=
PROXY_LOCK_FAILURES=
PROXY_COOLDOWN_MINUTES=
# Credit loop: reclaim redeemed platform credits back to seats (off by default
# until a hub's pull endpoint is verified; never fails a redemption)
POOL_PULL_ENABLED=false
POOL_REBALANCE_ENABLED=false

# ---- Genie Sidekick Auth -----------------------------------------------
GENIE_ADMIN_EMAIL=
GENIE_ADMIN_PASSWORD=
GENIE_JWT_SECRET=

# ---- LLM Providers (Both apps) -----------------------------------------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

VENICE_API_KEY=
VENICE_MODEL=

OLLAMA_BASE_URL=
OLLAMA_MODEL=

# LLM presence probe (Boss status page). Any one provider key counts.
OPENAI_API_KEY=

# ---- Player Genie fallback (Concierge chat) ------------------------------
# Primary is CEREBRAS_* above. When Cerebras fails, chat falls over to any
# OpenAI-compatible endpoint configured here. Unset = chat 503s into the
# ticket fallback (tested behavior, safe).
GENIE_FALLBACK_API_KEY=
GENIE_FALLBACK_BASE_URL=https://api.openai.com/v1
GENIE_FALLBACK_MODEL=gpt-4o-mini

# ---- Monitoring ---------------------------------------------------------
CLOUDFLARE_API_TOKEN=
SENTRY_DSN=
# Comma-separated on-duty alert recipients. Unset = watchdog runs without email.
ALERT_EMAILS=
# Watchdog sweep cadence in minutes. Default 60.
ON_DUTY_INTERVAL_MIN=60

# ---- Telegram (ops bridge + Genie escalation relay) ----------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# When true, Genie [ESCALATE] events ping this chat instantly.
TELEGRAM_ESCALATION_ENABLED=false
TELEGRAM_ESCALATION_CHAT_ID=

# ---- Feature flags -------------------------------------------------------
# In-memory flag cache TTL in seconds. Default 60.
FLAG_CACHE_TTL_SECONDS=60

# ---- Scout Force ------------------------------------------------------
# Must match the scout-force Worker's LEADS_TOKEN secret exactly.
SCOUT_LEADS_TOKEN=

# ---- CORS (Genie) -------------------------------------------------------
CORS_ORIGINS=

# ---- Self-distributor ---------------------------------------------------
# Hours a queued task waits before the summary flags it overdue. Default 4.
DISTRIBUTOR_OVERDUE_HOURS=4

# ---- Ops tooling -----------------------------------------------------------
# Telegram bridge PR automation target ("owner/repo").
GITHUB_REPO=
# Optional Firebase secrets backend (services/firebase_secrets.py).
FIREBASE_PROJECT_ID=

# ---- Hub capture script (backend/scripts/capture_hub_api.py only) ----------
HUB_TYPE=
HUB_USERNAME=
HUB_PASSWORD=
HUB_RECIPIENT=
HUB_AMOUNT=

# ---- Testing ----------------------------------------------------------------
# 1 = also run the live-backend-gated suites (need a real Mongo + server).
RUN_BACKEND_TESTS=
