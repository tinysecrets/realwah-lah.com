# ============================================================================
# WAH-LAH Monorepo — Unified Environment Template
# One .env for both WAH-LAH backend and Genie Sidekick
# All secrets managed on the deployment platform — reference only
# ============================================================================

# ---- DATABASE (Shared) --------------------------------------------------
MONGO_URL=
MONGODB_URI=
MONGO_URI=
DB_NAME=

# ---- WAH-LAH Backend Auth -----------------------------------------------
JWT_SECRET=
COOKIE_SECURE=
COOKIE_SAMESITE=
CORS_ORIGINS=
ENFORCE_CANONICAL_HOST=
CANONICAL_HOST=
FRONTEND_URL=https://wah-lah.com
PASSWORD_RESET_PATH=/reset-password
FRONTEND_DIR=/app/genie_dist
APP_ENV=

ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- WAH-LAH Payments ---------------------------------------------------
CARD_PAYMENT_TAG=
CRYPTO_WALLET_ADDRESS=
LIGHTNING_ADDRESS=

# ---- WAH-LAH Stripe (removed) -------------------------------------------
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- WAH-LAH Bitcoin/BTC Pay -------------------------------------------
BTCPAY_API_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTC_GATEWAY_TYPE=

# ---- Bitcoin deposit processing (BlockCypher + Coinbase rate) ---------
# Token: https://accounts.blockcypher.com/. Address: a BTC address you control
# (all deposits go here). HD wallet vars optional if using a static address.
BLOCKCYPHER_TOKEN=
BLOCKCYPHER_STATIC_ADDRESS=
BLOCKCYPHER_XPUB=
BLOCKCYPHER_HD_WALLET=wah_lah_deposits
BTC_MIN_CONFIRMATIONS=1
BTC_FALLBACK_USD=60000
# Public base URL of the API — used for outbound webhook callback URLs.
PUBLIC_API_URL=https://api.wah-lah.com

# ---- WAH-LAH Email (Resend) --------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Legacy sender names are retained only for backward compatibility.
EMAIL_FROM=
CUSTOM_EMAIL_FROM=

# ---- WAH-LAH Compliance -------------------------------------------------
BLOCKED_STATES=
KYC_BASIC_THRESHOLD_USD=
KYC_ENHANCED_THRESHOLD_USD=
KYC_UPLOAD_DIR=
PERSONA_API_KEY=
PERSONA_ENVIRONMENT=
PERSONA_TEMPLATE_ID_BASIC=
PERSONA_TEMPLATE_ID_ENHANCED=
PERSONA_WEBHOOK_SECRET=
CTR_THRESHOLD_USD=
SAR_FREQ_WINDOW_HOURS=
SAR_FREQ_THRESHOLD=

# ---- WAH-LAH Distributor Pool -------------------------------------------
PROXY_ENCRYPTION_KEY=
PROXY_DEFAULT_PER_TRANSFER_CAP=
PROXY_DEFAULT_DAILY_CAP=
PROXY_COOLDOWN_FAILURES=
PROXY_LOCK_FAILURES=
PROXY_COOLDOWN_MINUTES=

# ---- WAH-LAH Sugar Sweeps -----------------------------------------------
SUGAR_SWEEPS_USERNAME=
SUGAR_SWEEPS_PASSWORD=
SUGAR_SWEEPS_URL=

# ---- Genie Sidekick Auth -----------------------------------------------
GENIE_ADMIN_EMAIL=
GENIE_ADMIN_PASSWORD=
GENIE_JWT_SECRET=

# ---- LLM Providers (Both apps) -----------------------------------------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

VENICE_API_KEY=
VENICE_MODEL=

OLLAMA_BASE_URL=
OLLAMA_MODEL=

EMERGENT_LLM_KEY=

# ---- Monitoring ---------------------------------------------------------
CLOUDFLARE_API_TOKEN=
SENTRY_DSN=

# ---- CORS (Genie) -------------------------------------------------------
CORS_ORIGINS=
